# =============================================================================
# Alpha Trading Bot - 配置模板
# =============================================================================
# 使用说明:
#   1. 复制此文件为 .env
#   2. 填入你的API密钥等信息
#   3. 无需的项目可留空或删除
# =============================================================================

# =============================================================================
# 交易所配置 (OKX)
# =============================================================================
OKX_API_KEY=                                             # OKX API Key
OKX_SECRET=                                              # OKX Secret
OKX_PASSWORD=                                            # OKX Password
OKX_SYMBOL=BTC/USDT:USDT                                 # 交易对符号 (如 BTC/USDT:USDT, ETH/USDT:USDT)
OKX_LEVERAGE=10                                          # 杠杆倍数 (如 10 = 10倍杠杆)

# =============================================================================
# 交易周期配置
# =============================================================================
# 说明: 机器人按设定周期自动执行交易逻辑
CYCLE_MINUTES=15                                         # 交易周期(分钟) (如 15 = 每15分钟执行一次)
RANDOM_OFFSET_RANGE=180                                  # 随机偏移范围(秒) (如 180 = ±3分钟随机偏移，避免风控检测)

# =============================================================================
# AI配置 - 单AI模式 (推荐新手使用)
# =============================================================================
# 说明: 使用单个AI提供商进行分析，配置简单，响应快速
AI_MODE=single                                           # AI模式选择: single=单AI, fusion=多AI融合
AI_DEFAULT_PROVIDER=mimo                             # 单AI模式下的AI提供商 (可选: deepseek/kimi/openai/qwen/gemini/minimax/mimo)

# =============================================================================
# AI配置 - 多AI融合模式 (推荐进阶用户使用)
# =============================================================================
# 说明: 同时调用多个AI，综合分析结果，提高信号可靠性
# 融合策略说明:
#   - consensus (共识): 所有AI都给出相同信号才执行，风险最低
#   - weighted (加权平均): 根据权重计算各信号得分，得分最高者胜出
#   - majority (多数表决): 超过阈值比例的信号作为最终结果
#   - confidence (置信度): buy/sell信号优先于hold，需达到阈值

AI_FUSION_PROVIDERS=deepseek,kimi,mimo                        # 参与融合的AI提供商列表 (逗号分隔)
                                                        # 示例: deepseek,kimi,openai,mimo
                                                        # 可选: deepseek/kimi/openai/qwen/gemini/minimax/mimo

AI_FUSION_STRATEGY=weighted                              # 融合策略 (consensus/weighted/majority/confidence)
                                                        # 推荐: weighted (加权平均，综合考虑各AI意见)

AI_FUSION_WEIGHTS=deepseek:0.3,kimi:0.3,mimo:0.4      # 各提供商权重 (格式: 提供商:权重,提供商:权重)
                                                        # 权重范围: 0.0-1.0，所有权重之和建议等于1
                                                        # 示例: deepseek:0.6,kimi:0.4 表示deepseek权重60%，kimi权重40%

AI_FUSION_THRESHOLD=0.6                                  # 融合阈值 (范围: 0.0-1.0)
                                                        # 含义: 达到此比例的信号才会被执行
                                                        # 示例: 0.6 表示60%以上的AI同意才执行
                                                        # 注意: consensus模式此参数无效

# =============================================================================
# AI API Keys (各提供商独立配置)
# =============================================================================
# 说明: 填入对应AI提供商的API Key，留空则使用默认配置
# 获取地址:
#   - DeepSeek: https://platform.deepseek.com
#   - Kimi: https://platform.moonshot.cn
#   - OpenAI: https://platform.openai.com
#   - Qwen: https://dashscope.console.aliyun.com
#   - Gemini: https://ai.google.dev/gemini-api/docs/api-key
DEEPSEEK_API_KEY=                                        # DeepSeek API Key
KIMI_API_KEY=                                            # Kimi API Key
OPENAI_API_KEY=                                          # OpenAI API Key
QWEN_API_KEY=                                            # Qwen API Key
GEMINI_API_KEY=                                          # Gemini API Key (或使用 GOOGLE_API_KEY)
GOOGLE_API_KEY=                                          # Gemini 兼容环境变量，优先级高于 GEMINI_API_KEY
MINIMAX_API_KEY=                                         # MiniMax API Key（可选）
MIMO_API_KEY=your-mimo-api-key                          # MiMo (小米) API Key（可选）

# =============================================================================
# 止损配置
# =============================================================================
# 说明: 止损比例用于控制单笔交易的最大亏损
# 计算方式: 止损价 = 入仓价 × (1 - 止损比例)

STOP_LOSS_PERCENT=0.005                                  # 亏损时止损比例 (范围: 0.001-0.1)
                                                        # 示例: 0.005 = 0.5% (入仓价10000，止损价9950)
                                                        # 说明: 价格下跌时触发，保护本金

STOP_LOSS_PROFIT_PERCENT=0.002                           # 盈利时止损比例 (范围: 0.001-0.1)
                                                        # 示例: 0.002 = 0.2% (入仓价10000，止损价9980)
                                                        # 说明: 价格上涨后触发，锁定部分利润

TAKE_PROFIT_PERCENT=0.06                                 # 止盈比例 (范围: 0.01-0.5)
STOP_LOSS_TOLERANCE_PERCENT=0.001                        # 止损价容错比例 (范围: 0.0-0.01)
ALLOW_SHORT_SELLING=true                                 # 是否允许做空 (true/false)

# =============================================================================
# 智能止盈止损配置 (Smart TP/SL)
# =============================================================================
# 说明: 智能止盈止损基于入场价格计算，更精确的止损止盈
TAKE_PROFIT_ENABLED=true                                 # 启用止盈 (true/false)
STOP_LOSS_ENABLED=true                                   # 启用止损 (true/false)
TAKE_PROFIT_MODE=smart                                   # 止盈模式: normal=普通, smart=智能
STOP_LOSS_MODE=smart                                     # 止损模式: normal=普通, smart=智能
SMART_TP_SL_ENABLED=true                                 # 智能止盈止损总开关 (true/false)

# =============================================================================
# 投资类型配置
# =============================================================================
# 说明: conservative=保守型, moderate=稳健型, aggressive=激进型
# 保守型: R/R阈值0.8, 止盈6%, 止损2%, 更严格的风险控制
INVESTMENT_TYPE=conservative                             # 投资类型: conservative/moderate/aggressive

# =============================================================================
# 保守型智能多级止盈配置
# =============================================================================
# 说明: 保守型投资者使用更保守的止盈止损设置
CONSERVATIVE_SMART_FIXED_TP_PERCENT=4.0                  # 保守型固定止盈百分比 (4%)
CONSERVATIVE_SMART_FIXED_SL_PERCENT=1.5                  # 保守型固定止损百分比 (1.5%)
CONSERVATIVE_SMART_MULTI_TP_LEVELS=2,3.5,5               # 保守型多级止盈级别 (2%, 3.5%, 5%)
CONSERVATIVE_SMART_MULTI_TP_RATIOS=0.5,0.3,0.2          # 保守型各级别平仓比例 (50%, 30%, 20%)
CONSERVATIVE_NORMAL_TP_PERCENT=6                         # 保守型普通止盈百分比
CONSERVATIVE_NORMAL_SL_PERCENT=2                         # 保守型普通止损百分比

# =============================================================================
# 追踪止损配置 (Trailing Stop)
# =============================================================================
TRAILING_STOP_ENABLED=true                               # 启用追踪止损 (true/false)
TRAILING_DISTANCE=1.5                                    # 追踪止损距离百分比 (1.5%)
TRAILING_STOP_LOSS_ENABLED=true                          # 启用追踪止损功能 (true/false)
TRAILING_STOP_LOSS_MODE=entry_based                      # 追踪止损模式: entry_based
ADVANCED_TRAILING_ENABLED=true                           # 启用高级追踪止损 (true/false)
ADVANCED_TRAILING_MODE=conservative                      # 高级追踪模式: conservative/moderate/aggressive
PROFIT_LOCK_ENABLED=true                                 # 启用利润锁定 (true/false)

# =============================================================================
# 自适应止损配置 (Adaptive Stop Loss)
# =============================================================================
ADAPTIVE_STOP_LOSS_ENABLED=true                          # 启用自适应止损 (true/false)
UP_TREND_STOP_LOSS=0.02                                  # 上升趋势止损比例 (2%)
DOWN_TREND_STOP_LOSS=0.04                                # 下降趋势止损比例 (4%)

# =============================================================================
# 风险控制配置
# =============================================================================
MAX_DAILY_LOSS=100                                       # 最大每日亏损 (USDT)
MAX_POSITION_RISK=5                                      # 最大仓位风险百分比 (5%)
MAX_CONSECUTIVE_LOSSES=3                                 # 最大连续亏损次数

# =============================================================================
# AlphaPulse 实时监控配置
# =============================================================================
ALPHA_PULSE_ENABLED=true                                 # 启用AlphaPulse实时监控 (true/false)
ALPHA_PULSE_SYMBOLS=BTC/USDT:USDT                        # 监控的交易对 (逗号分隔)
ALPHA_PULSE_MAX_OHLCV_BARS=200                           # 内存中最大K线数量
ALPHA_PULSE_MAX_INDICATOR_HISTORY=100                    # 指标快照历史最大数量

# =============================================================================
# 系统配置
# =============================================================================
LOG_LEVEL=INFO                                           # 日志级别 (DEBUG/INFO/WARNING/ERROR)
                                                        # DEBUG: 详细调试信息
                                                        # INFO: 一般运行信息 (推荐)
                                                        # WARNING: 警告信息
                                                        # ERROR: 错误信息

# =============================================================================
# 运行模式配置
# =============================================================================
TEST_MODE=true                                           # 运行模式: true=测试模式, false=实盘模式
                                                        # 测试模式: 获取真实行情，执行策略逻辑，但不下单
                                                        # 实盘模式: 获取真实行情，执行真实交易（下单）
                                                        # 推荐: 先用测试模式验证逻辑，确认无误后再改为实盘模式
REAL_TRADING_CONFIRMED=false                             # 实盘二次确认开关（实盘时必须为true）
RUNTIME_ENVIRONMENT=dev                                  # 运行环境: dev/test/staging/prod（实盘仅允许prod/production）

# =============================================================================
# 运行机器学习ML配置
# =============================================================================
BOT_MODE=standard                                       # 运行模式: standard=标准模式, adaptive=ML模式
